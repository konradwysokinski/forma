# Copy to .env.local (git ignores *.local) to sign in with Strava during `npm run dev`.
# The same variables are set in Vercel: Project → Settings → Environment Variables.
# Forma has its own Strava API app (not Kilometr's). Never commit the secret.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# The browser needs the Client ID too, for the sign-in link (public).
VITE_STRAVA_CLIENT_ID=
